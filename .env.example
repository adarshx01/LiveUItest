# --- core ---------------------------------------------------------------
AITEST_ENVIRONMENT=development
AITEST_LOG_LEVEL=INFO
AITEST_DATABASE_URL=postgresql+asyncpg://aitest:aitest@localhost:5432/aitest
AITEST_CHECKPOINT_DATABASE_URL=postgresql://aitest:aitest@localhost:5432/aitest
AITEST_REDIS_URL=redis://localhost:6379/0
# Fernet key for the secret store (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AITEST_SECRET_KEY=
# Comma-free JSON list of API keys accepted by the API
AITEST_API_KEYS=["dev-api-key"]

# --- browser (Playwright MCP) ----------------------------------------------------
AITEST_MCP_TRANSPORT=stdio            # stdio (spawn per execution) | http (remote browser worker)
AITEST_MCP_HTTP_URL=                  # e.g. http://browser:8931/mcp when transport=http
AITEST_BROWSER_HEADLESS=true
AITEST_BROWSER_VIEWPORT=1280x800
AITEST_BROWSER_EXECUTABLE_PATH=       # leave empty to use the browser installed for the pinned Playwright
AITEST_BROWSER_RECORD_VIDEO=true
AITEST_MAX_CONCURRENT_EXECUTIONS=4

# --- models (optional; the platform runs deterministically without one) ----------
AITEST_LLM_PROVIDER=none              # none | anthropic | openai_compatible
# ANTHROPIC_API_KEY=                  # read by the Anthropic SDK when provider=anthropic
AITEST_LLM_REASONING_MODEL=claude-opus-5-5
AITEST_LLM_CLASSIFICATION_MODEL=claude-haiku-5-5
AITEST_LLM_VISION_MODEL=claude-opus-5-5
AITEST_OPENAI_BASE_URL=
AITEST_OPENAI_API_KEY=

# --- governance -------------------------------------------------------------
AITEST_ALLOWED_DOMAINS=[]             # extra domains beyond each test's base URL host
AITEST_ALLOW_DESTRUCTIVE_ACTIONS=false
AITEST_ALLOW_FINANCIAL_ACTIONS=false
AITEST_ALLOW_MESSAGING_ACTIONS=false

# --- artifacts --------------------------------------------------------------
AITEST_ARTIFACT_BACKEND=local         # local | s3
AITEST_S3_ENDPOINT_URL=
AITEST_S3_BUCKET=aitest-artifacts
