# =====================================================================================================
# AI testing platform - configuration
#
# Copy this file to .env (Windows: copy .env.example .env) and fill in what you need. Every setting has a
# safe default: with nothing filled in, the platform runs fully locally - SQLite database, filesystem
# artifacts, in-process events, deterministic (model-free) understanding, headless Chromium.
#
# Never commit .env. Never paste API keys or passwords into test cases, chat, tickets or screenshots:
# put passwords in the encrypted secret store (--secret name=value, or the UI) and reference them as
# {{name}} in the test. Values written inline in a test ("Enter Pa55 as Password") are moved into the
# secret store and masked automatically, but they have still been on your clipboard and disk.
# =====================================================================================================

# --- core ---------------------------------------------------------------------------------------------
AITEST_ENVIRONMENT=development        # development | test | production
AITEST_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
AITEST_LOG_JSON=false                 # true for log shippers; false is easier to read in a terminal

# --- database (local-first) ---------------------------------------------------------------------------
# Default (leave commented): SQLite file data/aitest.db, created and migrated automatically. No server,
# no Docker, no admin rights. LangGraph checkpoints go to data/checkpoints.db next to it.
# AITEST_DATABASE_URL=sqlite+aiosqlite:///C:/work/LiveUItest/data/aitest.db
#
# Optional PostgreSQL (team / server installs; enables pgvector similarity search for the memory):
# AITEST_DATABASE_URL=postgresql+asyncpg://aitest:aitest@localhost:5432/aitest
#
# "auto" puts checkpoints in the same database as above; set an explicit URL only to separate them.
AITEST_CHECKPOINT_DATABASE_URL=auto

# --- Redis (optional) ---------------------------------------------------------------------------------
# Not needed locally: events and executions run in-process. Enable only for multi-process deployments
# (separate API and worker processes sharing one queue).
AITEST_USE_REDIS=false
AITEST_REDIS_URL=                     # e.g. redis://localhost:6379/0 when AITEST_USE_REDIS=true
AITEST_RUN_WORKER_IN_API=true         # false = API only enqueues; run "python -m backend.workers.execution_worker"

# --- secrets ------------------------------------------------------------------------------------------
# A Fernet key encrypts the secret store and sealed run data. Leave AITEST_SECRET_KEY empty locally: the
# key is created once and kept in the OS credential store (Windows Credential Manager / macOS Keychain /
# Secret Service) or, if none is available, in data/secret.key (permissions restricted to your user).
# Set it explicitly only when several processes or machines must share one key (servers, docker compose):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Check which source is in use with: python -m backend.cli doctor
AITEST_SECRET_KEY=
AITEST_SECRET_KEY_STORE=auto          # auto (keyring, else file) | keyring | file
# JSON list of API keys accepted by the REST API (X-API-Key header). Change it for anything shared.
AITEST_API_KEYS=["dev-api-key"]

# --- browser (Playwright MCP) -------------------------------------------------------------------------
AITEST_MCP_TRANSPORT=stdio            # stdio (spawn a browser per execution) | http (remote browser worker)
AITEST_MCP_HTTP_URL=                  # e.g. http://browser:8931/mcp when transport=http
# Headless by default. Watch a run with "run --headed" (one run) or set false here (every run, including
# runs started from the UI/API). The per-run option always wins over this default.
AITEST_BROWSER_HEADLESS=true
AITEST_BROWSER_VIEWPORT=1280x800
# Leave empty to use the Chromium installed by "npx playwright install chromium". A path that does not
# exist is ignored with a warning (e.g. C:/Program Files/Google/Chrome/Application/chrome.exe).
AITEST_BROWSER_EXECUTABLE_PATH=
AITEST_BROWSER_RECORD_VIDEO=true
AITEST_MAX_CONCURRENT_EXECUTIONS=4

# --- execution behaviour ------------------------------------------------------------------------------
# After a failed *check*, keep running the remaining steps (the check changed nothing, so later steps are
# still valid). A failed *action* always skips the steps that depend on it. "never" = stop at first failure.
AITEST_CONTINUE_ON_FAILURE=assertions # assertions | never
# Extra model-guided recovery attempts per failed step, after the deterministic strategies (0 disables).
AITEST_LLM_RECOVERY_ATTEMPTS=1
AITEST_SCREENSHOT_POLICY=every_action # every_action | on_failure | off

# --- models (optional: the platform runs deterministically without one) -------------------------------
# none | anthropic | openai_compatible | azure_openai
AITEST_LLM_PROVIDER=none
AITEST_LLM_REQUEST_TIMEOUT_SECONDS=120
AITEST_LLM_MAX_RETRIES=2              # SDK retries with exponential backoff on 429 / 5xx / timeouts

# Anthropic (AITEST_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
AITEST_LLM_REASONING_MODEL=claude-opus-5-5
AITEST_LLM_CLASSIFICATION_MODEL=claude-haiku-5-5
AITEST_LLM_VISION_MODEL=claude-opus-5-5

# Any OpenAI-compatible endpoint (AITEST_LLM_PROVIDER=openai_compatible)
AITEST_OPENAI_BASE_URL=
AITEST_OPENAI_API_KEY=

# Azure OpenAI (AITEST_LLM_PROVIDER=azure_openai)
#   Endpoint: the resource URL from the Azure portal (Keys and Endpoint), e.g. https://my-resource.openai.azure.com/
#   Deployment: the *deployment name* you created in Azure AI Foundry, not the model name.
#   Verify with: python -m backend.cli check-llm   (one tiny call per tier, prints an actionable diagnosis)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Optional per-tier deployments (fall back to AITEST_LLM_*_MODEL when those are not Claude model names,
# then to AZURE_OPENAI_DEPLOYMENT). A small classification model escalates to the reasoning one on failure.
AZURE_OPENAI_REASONING_DEPLOYMENT=
AZURE_OPENAI_CLASSIFICATION_DEPLOYMENT=
AZURE_OPENAI_VISION_DEPLOYMENT=
# auto: Responses API, falling back to Chat Completions when the resource/version lacks it | responses | chat
AZURE_OPENAI_API=auto

# --- governance ---------------------------------------------------------------------------------------
# Each test may only visit its own base-URL host (plus localhost). Add identity providers and other hosts
# a flow legitimately crosses, e.g. ["stg-keycloak.example.com"] for an SSO login page. Per run: --allow-domain.
AITEST_ALLOWED_DOMAINS=[]
AITEST_ALLOW_DESTRUCTIVE_ACTIONS=false
AITEST_ALLOW_FINANCIAL_ACTIONS=false
AITEST_ALLOW_MESSAGING_ACTIONS=false

# --- artifacts (screenshots, videos, reports) ---------------------------------------------------------
AITEST_ARTIFACT_BACKEND=local         # local (data/artifacts) | s3
AITEST_S3_ENDPOINT_URL=
AITEST_S3_BUCKET=aitest-artifacts
